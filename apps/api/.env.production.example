APP_NAME=Farelin
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/triplet
FRONTEND_URL=https://www.farelin.com
API_PUBLIC_BASE_URL=https://YOUR-FARELIN-API.up.railway.app
# OAuth returns through Vercel's same-origin /backend rewrite, so auth cookies
# are stored for farelin.com rather than the Railway hostname.
AUTH_PUBLIC_BASE_URL=https://www.farelin.com/backend
# Optional exact preview/staging origins, comma-separated. Never use wildcards.
ADDITIONAL_ALLOWED_ORIGINS=

FLIGHT_PROVIDER=hybrid
LIVE_FLIGHT_PROVIDER=travelpayouts
ENABLE_DEV_TOOL_ENDPOINTS=false
# Travelpayouts/Aviasales cached indicative fares and attributed outbound links.
TRAVELPAYOUTS_API_ENABLED=true
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_AFFILIATE_BASE_URL=https://www.aviasales.com
TRAVELPAYOUTS_CACHE_ENABLED=true
SKYSCANNER_API_ENABLED=false
SKYSCANNER_API_KEY=
SKYSCANNER_BASE_URL=https://partners.api.skyscanner.net
SKYSCANNER_TIMEOUT_SECONDS=20
SKYSCANNER_MAX_REQUESTS_PER_SEARCH=30
SKYSCANNER_CACHE_ENABLED=true
SKYSCANNER_MARKET=SI
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=EUR
SKYSCANNER_USE_INDICATIVE_PRICES=true
SKYSCANNER_USE_LIVE_PRICES=true
SKYSCANNER_POLL_ATTEMPTS=3
SKYSCANNER_POLL_DELAY_SECONDS=1
SKYSCANNER_AFFILIATE_ENABLED=true
SKYSCANNER_MEDIA_PARTNER_ID=
SKYSCANNER_AFFILIATE_BASE_URL=https://skyscanner.net/g/referrals/v1
SKYSCANNER_AFFILIATE_UTM_SOURCE=triplet
SKYSCANNER_AFFILIATE_UTM_MEDIUM=affiliate
SKYSCANNER_AFFILIATE_UTM_CAMPAIGN=triplet_search

AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.2
OPENAI_REASONING_EFFORT=low
AI_MAX_TOOL_CALLS=3
AI_REQUIRE_TOOL_RESULTS=true
AI_MAX_TRIPS_SENT_TO_MODEL=8

APP_SECRET=replace-with-a-long-random-secret
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
API_RATE_LIMIT_WINDOW_SECONDS=60
TRIPS_SEARCH_RATE_LIMIT_MAX_ATTEMPTS=60
AI_SEARCH_RATE_LIMIT_MAX_ATTEMPTS=20
PROVIDER_SMOKE_TEST_RATE_LIMIT_MAX_ATTEMPTS=10
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional until Apple Sign In is enabled.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

BILLING_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Managed Payments requires 2025-03-31.basil or newer.
STRIPE_API_VERSION=2025-03-31.basil
# Stripe acts as merchant of record for Farelin's digital subscription.
STRIPE_MANAGED_PAYMENTS_ENABLED=true
# Enable only after tax registrations have been configured in Stripe.
STRIPE_AUTOMATIC_TAX_ENABLED=false
BILLING_SUCCESS_URL=https://www.farelin.com/billing/success
BILLING_CANCEL_URL=https://www.farelin.com/pricing
BILLING_PORTAL_RETURN_URL=https://www.farelin.com/dashboard

EMAIL_PROVIDER=resend
EMAIL_REQUIRE_REAL_PROVIDER=true
EMAIL_FROM=alerts@farelin.com
EMAIL_REPLY_TO=hello@farelin.com
CONTACT_EMAIL_TO=hello@farelin.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

ALERTS_PUBLIC_BASE_URL=https://www.farelin.com
RATE_LIMIT_REQUIRE_SHARED=true
REDIS_URL=
TRUST_PROXY_HEADERS=true
TRUSTED_CLIENT_IP_HEADER=x-real-ip
EXPOSE_API_DOCS=false
