APP_NAME=Triplet
APP_ENV=local
DATABASE_URL=postgresql+psycopg://triplet:triplet@localhost:5433/triplet
FLIGHT_PROVIDER=database
# Worldwide discovery provider. Other adapters remain dormant unless explicitly configured.
LIVE_FLIGHT_PROVIDER=travelpayouts
ENABLE_DEV_TOOL_ENDPOINTS=true
# Duffel Flights API (live offers; search only, Triplet never books).
DUFFEL_API_ENABLED=false
DUFFEL_API_KEY=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=30
DUFFEL_MAX_REQUESTS_PER_SEARCH=10
DUFFEL_CACHE_ENABLED=true
DUFFEL_CURRENCY=EUR
# Travelpayouts/Aviasales Data API (indicative cached prices + affiliate links).
TRAVELPAYOUTS_API_ENABLED=false
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
TRAVELPAYOUTS_AFFILIATE_BASE_URL=https://www.aviasales.com
TRAVELPAYOUTS_TIMEOUT_SECONDS=20
TRAVELPAYOUTS_MAX_REQUESTS_PER_SEARCH=30
TRAVELPAYOUTS_DISCOVERY_LIMIT_PER_ORIGIN=100
TRAVELPAYOUTS_CACHE_ENABLED=true
# Deal cache freshness. The hourly tick re-reads the provider, so the serve TTL
# only bites when a tick is late. Retention is longer so a late tick cannot empty
# the cache. Note: refreshing more often does not make an individual fare newer —
# Travelpayouts serves fares travellers searched in the last ~7 days.
DEALS_SERVE_TTL_HOURS=6
DEALS_RETENTION_HOURS=48
# Never quote a price the provider last saw longer ago than this.
MAX_FARE_AGE_DAYS=7
# Origins the hourly warm-up covers (seeded candidates + airports users chose).
# ~5 provider calls per origin per run.
DEALS_MAX_WARMED_ORIGINS=40
TRAVELPAYOUTS_CURRENCY=EUR
# Skyscanner (dormant: requires partner approval; keep disabled).
SKYSCANNER_API_ENABLED=false
SKYSCANNER_API_KEY=
SKYSCANNER_BASE_URL=https://partners.api.skyscanner.net
SKYSCANNER_TIMEOUT_SECONDS=20
SKYSCANNER_MAX_REQUESTS_PER_SEARCH=30
SKYSCANNER_CACHE_ENABLED=true
SKYSCANNER_MARKET=SI
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_CURRENCY=EUR
SKYSCANNER_USE_INDICATIVE_PRICES=true
SKYSCANNER_USE_LIVE_PRICES=true
SKYSCANNER_POLL_ATTEMPTS=3
SKYSCANNER_POLL_DELAY_SECONDS=1
SKYSCANNER_AFFILIATE_ENABLED=true
SKYSCANNER_MEDIA_PARTNER_ID=
SKYSCANNER_AFFILIATE_BASE_URL=https://skyscanner.net/g/referrals/v1
SKYSCANNER_AFFILIATE_UTM_SOURCE=triplet
SKYSCANNER_AFFILIATE_UTM_MEDIUM=affiliate
SKYSCANNER_AFFILIATE_UTM_CAMPAIGN=triplet_search
AI_ENABLED=false
# openai or anthropic
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.2
OPENAI_REASONING_EFFORT=low
AI_MAX_TOOL_CALLS=3
AI_REQUIRE_TOOL_RESULTS=true
AI_MAX_TRIPS_SENT_TO_MODEL=8
AI_MAX_INPUT_TOKENS_HINT=12000
AI_DAILY_REQUEST_LIMIT_PLACEHOLDER=100
APP_SECRET=dev-secret-change-me
AUTH_ENABLED=true
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
API_RATE_LIMIT_WINDOW_SECONDS=60
TRIPS_SEARCH_RATE_LIMIT_MAX_ATTEMPTS=60
AI_SEARCH_RATE_LIMIT_MAX_ATTEMPTS=20
PROVIDER_SMOKE_TEST_RATE_LIMIT_MAX_ATTEMPTS=10
API_PUBLIC_BASE_URL=http://localhost:8001
AUTH_PUBLIC_BASE_URL=http://localhost:8001
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
BILLING_SUCCESS_URL=http://localhost:3000/billing/success
BILLING_CANCEL_URL=http://localhost:3000/pricing
BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard
# Accounts with every plan limit lifted, for running and testing Triplet itself.
# Comma-separated emails. Set per environment; never commit real addresses.
TRIPLET_OWNER_EMAILS=
TRIPLET_PUBLIC_MAX_ORIGIN_AIRPORTS=6
TRIPLET_FREE_SAVED_SEARCH_LIMIT=1
TRIPLET_FREE_AI_SEARCHES_PER_MONTH=3
TRIPLET_FREE_MAX_ORIGIN_AIRPORTS=3
TRIPLET_FREE_ALERT_FREQUENCIES=weekly
TRIPLET_TRIAL_DURATION_DAYS=7
TRIPLET_TRIAL_AI_SEARCHES_TOTAL=15
TRIPLET_TRIAL_SAVED_SEARCH_LIMIT=3
TRIPLET_TRIAL_MAX_ORIGIN_AIRPORTS=6
TRIPLET_TRIAL_ALERT_FREQUENCIES=daily,weekly
TRIPLET_PRO_SAVED_SEARCH_LIMIT=10
TRIPLET_PRO_AI_SEARCHES_PER_MONTH=100
TRIPLET_PRO_MAX_ORIGIN_AIRPORTS=8
TRIPLET_PRO_ALERT_FREQUENCIES=daily,weekly
FRONTEND_URL=http://localhost:3000
ALERTS_ENABLED=false
ALERTS_DEFAULT_FREQUENCY=daily
ALERTS_MAX_RESULTS_PER_EMAIL=5
ALERTS_MIN_HOURS_BETWEEN_NOTIFICATIONS=24
ALERTS_PUBLIC_BASE_URL=http://localhost:3000
# Either "console" (logs the message, sends nothing — the local default) or
# "smtp" (any real mail service). There is no separate Resend/Postmark/SES
# setting: those are all reached over SMTP with the three variables below.
# An unrecognised value logs an error and delivers nothing rather than
# silently pretending to work.
EMAIL_PROVIDER=console
# Refuse to start rather than run without working email. Checks whether the
# resolved provider actually delivers, so it also catches a typo'd provider
# name and a half-configured SMTP block — not just EMAIL_PROVIDER=console.
# Leave false locally; set true in production once a real provider is
# configured, so a misconfigured deploy is loud instead of silently dropping
# every watch confirmation and fare alert.
EMAIL_REQUIRE_REAL_PROVIDER=false
EMAIL_FROM=alerts@triplet.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Abuse protection -------------------------------------------------------
# Shared rate-limit counters. Without this each worker counts separately, so
# production requires it unless you declare a single worker below.
REDIS_URL=
# Refuse to start rather than run per-process limits. For multi-worker
# deployments only; leaving it false means a missing REDIS_URL warns instead.
RATE_LIMIT_REQUIRE_SHARED=false
# Trust X-Forwarded-For for the caller's address. True behind a proxy (Railway,
# Vercel); false for a directly exposed service, or callers pick their own identity.
TRUST_PROXY_HEADERS=true
RATE_LIMIT_CHEAP_PER_WINDOW=240
RATE_LIMIT_ALERTS_PER_WINDOW=10
# Service-wide ceiling on model calls per day. Reaching it degrades to the
# rule-based parser rather than breaking search. 0 disables the ceiling.
AI_DAILY_REQUEST_LIMIT=2000
AI_MAX_MESSAGE_CHARS=2000
# Interactive API docs. Off in production unless set true.
EXPOSE_API_DOCS=false

# --- Homepage board ----------------------------------------------------------
# Assembled by the scheduled tick and served from the database, so a landing
# page view never reaches a flight provider. Origins are shown to anonymous
# visitors as examples, never as "your airports".
FEATURED_DEAL_ORIGINS=VIE,ZAG,TRS,VCE,BUD,LJU
FEATURED_DEAL_MAX_BUDGET=250
# After this long the page says the board is overdue rather than implying it
# was just refreshed. Set above your cron interval.
FEATURED_DEAL_STALE_AFTER_HOURS=6

# --- Plan pricing ------------------------------------------------------------
# Labels are what travellers see; the amounts are what the yearly saving is
# calculated from. Set both, or the pricing page quotes no saving rather than a
# number nobody checked.
TRIPLET_PRO_PRICE_MONTHLY_LABEL=€6.99/month
TRIPLET_PRO_PRICE_YEARLY_LABEL=€49/year
TRIPLET_PRO_PRICE_MONTHLY_AMOUNT=6.99
TRIPLET_PRO_PRICE_YEARLY_AMOUNT=49
